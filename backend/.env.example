PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecova_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecova_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
JWT_EXPIRES_IN=7d

# Frontend CORS
FRONTEND_URL=http://localhost:5173

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
